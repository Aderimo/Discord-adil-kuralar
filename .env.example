# Veritabanı Bağlantısı - PostgreSQL (Supabase, Neon, PlanetScale vb.)
DATABASE_URL="postgresql://user:password@host:5432/yetkili_kilavuzu?schema=public"

# JWT Secret - Güvenli, rastgele bir anahtar (min 32 karakter)
# Üretim için: openssl rand -base64 32
JWT_SECRET="change-this-to-a-strong-random-secret-min-32-chars"

# OpenAI API Key (AI Ceza Danışmanı için gerekli - opsiyonel)
# https://platform.openai.com/api-keys adresinden alınabilir
OPENAI_API_KEY="sk-your-openai-api-key-here"

# Next.js URL (Netlify deployment için)
NEXTAUTH_URL="https://your-site.netlify.app"
